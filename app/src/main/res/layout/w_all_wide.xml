<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ImageView android:id="@+id/bg_base" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_sys_auto_ga" />
<ViewFlipper android:id="@+id/bg_flip" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="6500" android:inAnimation="@anim/fade_in_slow" android:outAnimation="@anim/fade_out_slow">
    <ImageView android:id="@+id/bg_alt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_sys_auto_gb" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" />
</ViewFlipper>
<ImageView android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/glass_overlay" android:visibility="gone" />
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingLeft="18dp" android:paddingRight="16dp">
<LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1">
<TextClock android:id="@+id/tp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="36sp" android:textColor="@color/w_text1" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:singleLine="true" />
<TextClock android:id="@+id/ts_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textSize="12sp" android:textColor="@color/w_text2" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.1" />
</LinearLayout>
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
<TextView android:id="@+id/wx_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☀️" android:textSize="24sp" android:textColor="@color/w_text1" android:fontFamily="sans-serif" android:includeFontPadding="false" android:singleLine="true" />
<TextView android:id="@+id/wx_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--°" android:textSize="22sp" android:textColor="@color/w_text1" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true" android:layout_marginLeft="6dp" />
</LinearLayout>
</LinearLayout>
</FrameLayout>
