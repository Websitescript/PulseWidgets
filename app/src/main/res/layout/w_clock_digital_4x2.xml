<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ImageView android:id="@+id/bg_base" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_a" />
<ViewFlipper android:id="@+id/bg_flip" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="6500" android:inAnimation="@anim/fade_in_slow" android:outAnimation="@anim/fade_out_slow">
    <ImageView android:id="@+id/bg_alt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_b" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" />
</ViewFlipper>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingLeft="20dp" android:paddingRight="16dp">
<LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:baselineAligned="false">
<TextClock android:id="@+id/tp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="64sp" android:textColor="#E6FFFB" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:singleLine="true" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginLeft="6dp" android:layout_marginBottom="8dp">
<TextClock android:id="@+id/ta_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="ss" android:format24Hour="ss" android:textSize="20sp" android:textColor="#2DD4BF" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" />
<TextClock android:id="@+id/ts_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="a" android:format24Hour="EEE" android:textSize="11sp" android:textColor="#86BDB6" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" />
</LinearLayout>
</LinearLayout>
<ViewFlipper android:id="@+id/fl_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:autoStart="true" android:flipInterval="4200" android:inAnimation="@anim/slide_up_in" android:outAnimation="@anim/slide_up_out">
<TextClock android:id="@+id/ts_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEEE, d MMMM" android:format24Hour="EEEE, d MMMM" android:textSize="13sp" android:textColor="#86BDB6" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" >
<TextView android:id="@+id/ts_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WEEK " android:textSize="12sp" android:textColor="#86BDB6" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.12" />
<TextClock android:id="@+id/ta_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="w" android:format24Hour="w" android:textSize="12sp" android:textColor="#2DD4BF" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" />
</LinearLayout>
</ViewFlipper>
</LinearLayout>
<FrameLayout android:layout_width="96dp" android:layout_height="96dp">
<ProgressBar android:id="@+id/ring_teal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="0dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_teal" android:visibility="visible" />
<ProgressBar android:id="@+id/ring_coral" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="0dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_coral" android:visibility="gone" />
<ProgressBar android:id="@+id/ring_gold" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="0dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_gold" android:visibility="gone" />
<ProgressBar android:id="@+id/ring_aurora" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="0dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_aurora" android:visibility="gone" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="center" android:gravity="center_horizontal">
<TextClock android:id="@+id/tp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="d" android:format24Hour="d" android:textSize="30sp" android:textColor="#E6FFFB" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:singleLine="true" />
<TextClock android:id="@+id/ta_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="MMM" android:format24Hour="MMM" android:textSize="11sp" android:textColor="#2DD4BF" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.15" />
</LinearLayout>
</FrameLayout>
</LinearLayout>
</FrameLayout>
