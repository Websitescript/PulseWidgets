<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ImageView android:id="@+id/bg_base" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_a" />
<ViewFlipper android:id="@+id/bg_flip" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="6500" android:inAnimation="@anim/fade_in_slow" android:outAnimation="@anim/fade_out_slow">
    <ImageView android:id="@+id/bg_alt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_b" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" />
</ViewFlipper>
<ImageView android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/glass_overlay" android:visibility="gone" />
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:padding="10dp">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<ProgressBar android:id="@+id/ring_teal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_teal" android:visibility="visible" />
<ProgressBar android:id="@+id/ring_coral" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_coral" android:visibility="gone" />
<ProgressBar android:id="@+id/ring_gold" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_gold" android:visibility="gone" />
<ProgressBar android:id="@+id/ring_aurora" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="2dp" android:minWidth="8dp" android:minHeight="8dp" android:indeterminate="true" android:indeterminateOnly="true" android:indeterminateDrawable="@drawable/ring_aurora" android:visibility="gone" />
<AnalogClock android:id="@+id/analog" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_margin="12dp" android:dial="@drawable/clock_dial_ticks_s" android:hand_hour="@drawable/clock_hour_s" android:hand_minute="@drawable/clock_minute_s" android:hand_second="@drawable/clock_second_s" />
</FrameLayout>
<ViewFlipper android:id="@+id/fl_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp" android:autoStart="true" android:flipInterval="4000" android:inAnimation="@anim/slide_up_in" android:outAnimation="@anim/slide_up_out">
<TextClock android:id="@+id/ta_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEE, d MMM" android:format24Hour="EEE, d MMM" android:textSize="11sp" android:textColor="#2DD4BF" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.12" />
<TextClock android:id="@+id/ts_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm a" android:format24Hour="HH:mm" android:textSize="11sp" android:textColor="#86BDB6" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.12" />
</ViewFlipper>
</LinearLayout>
</FrameLayout>
