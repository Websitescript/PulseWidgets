<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ImageView android:id="@+id/bg_base" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_a" />
<ViewFlipper android:id="@+id/bg_flip" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="6500" android:inAnimation="@anim/fade_in_slow" android:outAnimation="@anim/fade_out_slow">
    <ImageView android:id="@+id/bg_alt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_b" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" />
</ViewFlipper>
<ImageView android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/glass_overlay" android:visibility="gone" />
<ViewFlipper android:id="@+id/fl_1" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="4500" android:inAnimation="@anim/slide_up_in" android:outAnimation="@anim/slide_up_out">
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center">
<TextClock android:id="@+id/ta_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="MMM" android:format24Hour="MMM" android:textSize="11sp" android:textColor="#2DD4BF" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.2" />
<TextClock android:id="@+id/tp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="d" android:format24Hour="d" android:textSize="44sp" android:textColor="#E6FFFB" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:singleLine="true" />
</LinearLayout>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center">
<TextClock android:id="@+id/ta_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEE" android:format24Hour="EEE" android:textSize="26sp" android:textColor="#2DD4BF" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" />
<TextClock android:id="@+id/ts_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="yyyy" android:format24Hour="yyyy" android:textSize="11sp" android:textColor="#86BDB6" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.15" />
</LinearLayout>
</ViewFlipper>
</FrameLayout>
