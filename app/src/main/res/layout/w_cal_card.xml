<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ImageView android:id="@+id/bg_base" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_sys_auto_ga" />
<ViewFlipper android:id="@+id/bg_flip" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="6500" android:inAnimation="@anim/fade_in_slow" android:outAnimation="@anim/fade_out_slow">
    <ImageView android:id="@+id/bg_alt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_sys_auto_gb" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" />
</ViewFlipper>
<ImageView android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/glass_overlay" android:visibility="gone" />
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="14dp">
<LinearLayout android:layout_height="wrap_content" android:orientation="horizontal" android:layout_width="match_parent">
<TextClock android:id="@+id/ta_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="MMMM" android:format24Hour="MMMM" android:textSize="12sp" android:textColor="@color/w_accent" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.2" />
<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<TextClock android:id="@+id/ts_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="yyyy" android:format24Hour="yyyy" android:textSize="12sp" android:textColor="@color/w_text2" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center">
<TextClock android:id="@+id/tp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="d" android:format24Hour="d" android:textSize="72sp" android:textColor="@color/w_text1" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:singleLine="true" />
</LinearLayout>
<TextClock android:id="@+id/tp_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEEE" android:format24Hour="EEEE" android:textSize="15sp" android:textColor="@color/w_text1" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" android:singleLine="true" android:layout_gravity="center_horizontal" />
</LinearLayout>
</FrameLayout>
