<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
<ImageView android:id="@+id/bg_base" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_a" />
<ViewFlipper android:id="@+id/bg_flip" android:layout_width="match_parent" android:layout_height="match_parent" android:autoStart="true" android:flipInterval="6500" android:inAnimation="@anim/fade_in_slow" android:outAnimation="@anim/fade_out_slow">
    <ImageView android:id="@+id/bg_alt" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/bg_teal_b" />
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" />
</ViewFlipper>
<ImageView android:id="@+id/bg_glass" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:src="@drawable/glass_overlay" android:visibility="gone" />
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingLeft="20dp" android:paddingRight="20dp">
<TextClock android:id="@+id/tp_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="58sp" android:textColor="#E6FFFB" android:fontFamily="sans-serif-light" android:includeFontPadding="false" android:singleLine="true" />
<TextClock android:id="@+id/ta_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="ss" android:format24Hour="ss" android:textSize="20sp" android:textColor="#2DD4BF" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:layout_marginLeft="6dp" />
<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
<ViewFlipper android:id="@+id/fl_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:autoStart="true" android:flipInterval="4200" android:inAnimation="@anim/slide_up_in" android:outAnimation="@anim/slide_up_out">
<TextClock android:id="@+id/ta_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="EEEE" android:format24Hour="EEEE" android:textSize="14sp" android:textColor="#2DD4BF" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.15" />
<TextClock android:id="@+id/ts_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:format12Hour="d MMMM yyyy" android:format24Hour="d MMMM yyyy" android:textSize="14sp" android:textColor="#86BDB6" android:fontFamily="monospace" android:includeFontPadding="false" android:singleLine="true" android:textAllCaps="true" android:letterSpacing="0.1" />
</ViewFlipper>
</LinearLayout>
</FrameLayout>
