<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Pulse">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".RefreshReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".widgets.ClockAnalog1x1" android:exported="true" android:label="Clock · Analog 1×1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_clock_analog_1x1" />
        </receiver>
        <receiver android:name=".widgets.ClockStack1x2" android:exported="true" android:label="Clock · Stacked 1×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_clock_stack_1x2" />
        </receiver>
        <receiver android:name=".widgets.ClockDigital2x1" android:exported="true" android:label="Clock · Digital 2×1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_clock_digital_2x1" />
        </receiver>
        <receiver android:name=".widgets.ClockAnalog2x2" android:exported="true" android:label="Clock · Analog 2×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_clock_analog_2x2" />
        </receiver>
        <receiver android:name=".widgets.ClockDigital4x2" android:exported="true" android:label="Clock · Digital 4×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_clock_digital_4x2" />
        </receiver>
        <receiver android:name=".widgets.ClockHero4x4" android:exported="true" android:label="Clock · Hero 4×4">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_clock_hero_4x4" />
        </receiver>
        <receiver android:name=".widgets.CalTile1x1" android:exported="true" android:label="Calendar · Tile 1×1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_cal_tile_1x1" />
        </receiver>
        <receiver android:name=".widgets.CalStrip2x1" android:exported="true" android:label="Calendar · Strip 2×1">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_cal_strip_2x1" />
        </receiver>
        <receiver android:name=".widgets.CalCard2x2" android:exported="true" android:label="Calendar · Card 2×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_cal_card_2x2" />
        </receiver>
        <receiver android:name=".widgets.CalWeek4x2" android:exported="true" android:label="Calendar · Week 4×2">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_cal_week_4x2" />
        </receiver>
        <receiver android:name=".widgets.CalMonth4x4" android:exported="true" android:label="Calendar · Month 4×4">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/info_cal_month_4x4" />
        </receiver>

    </application>
</manifest>
